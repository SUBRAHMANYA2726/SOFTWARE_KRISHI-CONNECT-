<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.krishiconnect</groupId>
  <artifactId>krishiconnect-qa</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>KrishiConnect QA suite</name>
  <description>Black-box and white-box automation for the KrishiConnect web app (ISE2501 CA3).</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <junit.version>5.11.4</junit.version>
    <selenium.version>4.27.0</selenium.version>
    <slf4j.version>2.0.16</slf4j.version>

    <!-- Override on the command line, e.g. -DbaseUrl=http://localhost:5173 -Dheadless=false -->
    <baseUrl>http://127.0.0.1:5173</baseUrl>
    <headless>true</headless>
    <browser>edge</browser>
    <uiTimeoutSeconds>20</uiTimeoutSeconds>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
          </includes>
          <argLine>-Dfile.encoding=UTF-8</argLine>
          <systemPropertyVariables>
            <baseUrl>${baseUrl}</baseUrl>
            <headless>${headless}</headless>
            <browser>${browser}</browser>
            <uiTimeoutSeconds>${uiTimeoutSeconds}</uiTimeoutSeconds>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
