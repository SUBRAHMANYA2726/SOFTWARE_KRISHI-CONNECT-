# Firebase web configuration (public identifiers, safe to ship in a browser build).
# Copy this file to .env.local and fill in the values from:
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# Leave these empty to run the app in clearly-labelled local demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public project details used on the landing page footer.
VITE_CONTACT_EMAIL=
VITE_REPOSITORY_URL=
